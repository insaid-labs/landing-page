<main id="main">
<section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{{ t("SOFTWARE CON PROPÓSITO. HECHO EN CHILE.", "PURPOSE-BUILT SOFTWARE. MADE IN CHILE.") }}</p><h1 id="hero-title">{{ t("Tu próximo salto.<br><span>Lo construimos.</span>", "Your next big step.<br><span>We build it.</span>") }}</h1><p class="hero-description">{{ t("Software a medida e IA para que tu negocio avance. Seguro desde la primera línea.", "Custom software and AI to move your business forward. Secure from the very first line.") }}</p><div class="hero-actions"><button class="button primary" data-contact>{{ t("Hablemos de tu proyecto", "Let’s talk about your project") }}{{ icon("arrow") }}</button><a class="text-link" href="#proyectos">{{ t("Ver lo que hacemos", "See what we build") }}{{ icon("down") }}</a></div><p class="hero-footnote">{{ t("Tú traes el desafío. Nosotros, el equipo.", "You bring the challenge. We bring the team.") }}</p></div>{{ hero_photo }}</div></section>
<section class="proof" aria-label="{{ t("Clientes, usuarios y productos", "Clients, users, and products") }}"><div class="container proof-inner"><p>{{ t("Ideas que ya son<br>parte del mundo real.", "Ideas already working<br>in the real world.") }}</p><div class="proof-logos"><a class="proof-gameclub" href="https://www.gameclub.cl/" target="_blank" rel="noopener noreferrer" aria-label="GameClub — {{ t("abrir sitio oficial", "open official website") }}">{{ brand("gameclub") }}</a><a class="logo-udp" href="https://www.udp.cl/" target="_blank" rel="noopener noreferrer" aria-label="Universidad Diego Portales — {{ t("abrir sitio oficial", "open official website") }}"><b>udp</b><span>Universidad<br>Diego Portales</span></a><a class="logo-pharma proof-pharma" href="https://pharmalogic.cl" target="_blank" rel="noopener noreferrer">{{ brand("pharmalogic") }}<span class="sr-only">{{ t("Abrir sitio oficial en otra pestaña", "Open official site in a new tab") }}</span></a><a class="proof-optiwallet" href="https://www.optiwallet.cl" target="_blank" rel="noopener noreferrer">{{ brand("optiwallet") }}<span class="sr-only">{{ t("Abrir sitio oficial en otra pestaña", "Open official site in a new tab") }}</span></a></div></div></section>

<section class="section work" id="proyectos" aria-labelledby="work-title"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">01 / {{ t("TRABAJO QUE HABLA POR NOSOTROS", "WORK THAT SPEAKS FOR ITSELF") }}</p><h2 id="work-title">{{ t("De una buena idea.<br>A algo que funciona.", "From a good idea.<br>To something that works.") }}</h2></div><div class="filters" role="group" aria-label="{{ t("Filtrar proyectos", "Filter projects") }}"><button class="filter" data-filter="all" aria-pressed="true">{{ t("Todos", "All work") }}</button><button class="filter" data-filter="product" aria-pressed="false">{{ t("Productos", "Products") }}</button><button class="filter" data-filter="client" aria-pressed="false">{{ t("Clientes", "Clients") }}</button></div></div><p id="filter-status" class="sr-only" aria-live="polite"></p><div class="projects-grid">
<article id="case-opti" class="project-card project-featured" data-category="product"><a class="project-image actual-opti" href="https://www.optiwallet.cl" target="_blank" rel="noopener noreferrer" aria-label="{{ t("Explorar OptiWallet en otra pestaña", "Explore OptiWallet in a new tab") }}"><div class="product-image-header">{{ brand("optiwallet") }}<span>{{ t("PRODUCTO PROPIO", "OUR PRODUCT") }}</span></div><div class="flat-browser"><div class="browser-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><span>optiwallet.cl</span>{{ icon("lock") }}</div><img src="/images/opti-screen.webp" width="1676" height="990" loading="lazy" alt="{{ t("Captura original de la página de OptiWallet, sin modificar la perspectiva.", "Original OptiWallet page screenshot, with no perspective distortion.") }}"></div><span class="screen-note">{{ t("CAPTURA REAL DEL PRODUCTO", "ACTUAL PRODUCT SCREENSHOT") }}</span><span class="image-open">{{ icon("arrow") }}</span></a><div class="project-copy"><div class="project-kicker"><span>OptiWallet</span><span class="live-status"><i></i>LIVE</span></div><h3>{{ t("La tarjeta correcta.<br>El descuento del día.", "The right card.<br>Today’s best discount.") }}</h3><p>{{ t("Compara 14 bancos en ~1 segundo. Sin pedir datos bancarios. Gratis en beta.", "Compare 14 banks in ~1 second. No banking details required. Free in beta.") }}</p><a class="text-link" href="https://www.optiwallet.cl" target="_blank" rel="noopener noreferrer">{{ t("Conocer OptiWallet", "Explore OptiWallet") }}{{ icon("arrow") }}</a><div class="project-tags"><span>FINTECH</span><span>PWA</span></div></div></article>
<article id="case-pharma" class="project-card project-featured reverse" data-category="product"><a class="project-image actual-pharma" href="https://pharmalogic.cl" target="_blank" rel="noopener noreferrer" aria-label="{{ t("Explorar PharmaLogic en otra pestaña", "Explore PharmaLogic in a new tab") }}"><div class="product-image-header">{{ brand("pharmalogic") }}<span>{{ t("PRODUCTO PROPIO", "OUR PRODUCT") }}</span></div><div class="flat-browser"><div class="browser-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><span>pharmalogic.cl</span>{{ icon("lock") }}</div><img src="/images/pharma-screen.webp" width="999" height="565" loading="lazy" alt="{{ t("Dashboard original de PharmaLogic. Vista de inventario farmacéutico, sin dispositivos ficticios.", "Original PharmaLogic dashboard. Pharmaceutical inventory view, without fictional devices.") }}"></div><span class="screen-note">{{ t("CAPTURA REAL DEL PRODUCTO", "ACTUAL PRODUCT SCREENSHOT") }}</span><span class="image-open">{{ icon("arrow") }}</span></a><div class="project-copy"><div class="project-kicker"><span>PharmaLogic</span><span>{{ t("SALUD PÚBLICA", "PUBLIC HEALTH") }}</span></div><h3>{{ t("Cada medicamento,<br>bajo control.", "Every medication,<br>accounted for.") }}</h3><p>{{ t("Trazabilidad e inventario para droguerías, municipalidades y CESFAM. Visibilidad en cada etapa.", "Traceability and inventory for distributors, municipalities, and CESFAM health centers. Visibility at every stage.") }}</p><a class="text-link" href="https://pharmalogic.cl" target="_blank" rel="noopener noreferrer">{{ t("Conocer PharmaLogic", "Explore PharmaLogic") }}{{ icon("arrow") }}</a><div class="project-tags"><span>JAVA · SPRING BOOT</span><span>POSTGRESQL · REACT · OPENAPI</span></div></div></article>
<article id="case-udp" class="project-card project-featured udp-project" data-category="product"><a class="project-image udp-visual" href="https://udp-map.vercel.app/" target="_blank" rel="noopener noreferrer" aria-label="{{ t("Abrir UDP Map en otra pestaña", "Open UDP Map in a new tab") }}"><div class="udp-map-backdrop" aria-hidden="true"></div><div class="udp-visual-title"><span class="udp-mark">udp<span>map</span></span><span>{{ t("EL CAMPUS, MÁS CERCA.", "YOUR CAMPUS, CLOSER.") }}</span></div><div class="udp-capture"><img src="/images/udp-map.webp" width="1320" height="2868" loading="lazy" alt="{{ t("Captura real de UDP Map: mapa de facultades, filtros, ficha de Ingeniería y Ciencias, eventos y foro.", "Actual UDP Map screenshot: faculty map, filters, Engineering and Sciences location card, events, and forum.") }}"></div><span class="screen-note">{{ t("CAPTURA REAL · VISTA MÓVIL", "ACTUAL SCREENSHOT · MOBILE VIEW") }}</span><span class="image-open">{{ icon("arrow") }}</span></a><div class="project-copy"><div class="project-kicker"><span>UDP Map</span><span>{{ t("MAPA UNIVERSITARIO", "UNIVERSITY MAP") }}</span></div><h3>{{ t("Tu campus.<br>Sin dar vueltas.", "Your campus.<br>Without the detours.") }}</h3><p>{{ t("Facultades y lugares en un mapa. Una forma visual de explorar el entorno universitario desde el celular.", "Faculties and places on a map. A visual way to explore the university area from your phone.") }}</p><a class="text-link" href="https://udp-map.vercel.app/" target="_blank" rel="noopener noreferrer">{{ t("Explorar UDP Map", "Explore UDP Map") }}{{ icon("arrow") }}</a><div class="project-tags"><span>{{ t("MAPA INTERACTIVO", "INTERACTIVE MAP") }}</span><span>{{ t("EXPERIENCIA MÓVIL", "MOBILE EXPERIENCE") }}</span></div></div></article>
<article id="case-gameclub" class="project-card client-project" data-category="client"><button class="client-visual game-visual" data-project="gameclub" aria-label="{{ t("Ver el proyecto de soporte IA para GameClub", "View the GameClub AI support project") }}"><div class="game-visual-heading">{{ brand("gameclub", "signature-on-dark") }}<span class="always-on">24/7</span></div><div class="message-stack"><div class="message user-message">{{ t("Hola, ¿me ayudan con mi conexión?", "Hi, can you help with my connection?") }}<small>22:48 ✓✓</small></div><div class="message support-message"><span class="support-icon">{{ icon("spark") }}</span><div><b>{{ t("¡Claro! Estoy aquí para ayudarte.", "Of course! I’m here to help.") }}</b><p>{{ t("Revisemos tu conexión paso a paso.", "Let’s check your connection, step by step.") }}</p><small>22:48</small></div></div><span class="message-ticket">{{ icon("checkcircle") }}{{ t("Del mensaje a la solución.", "From message to resolution.") }}</span></div><span class="visual-note">{{ t("Conversación ilustrativa", "Illustrative conversation") }}</span><span class="image-open">{{ icon("arrow") }}</span></button><div class="client-copy"><div class="project-kicker"><span>GameClub · {{ t("IA & automatización", "AI & automation") }}</span><span class="live-status"><i></i>LIVE 24/7</span></div><h3>{{ t("Tu equipo descansa.<br>La atención sigue.", "Your team rests.<br>Support keeps going.") }}</h3><p>{{ t("Soporte por WhatsApp con 3 capas antes de la IA. Menos consultas repetitivas para tu equipo.", "WhatsApp support with 3 layers before AI. Fewer repetitive queries for your team.") }}</p><button class="text-link" data-project="gameclub">{{ t("Así lo construimos", "How we built it") }}{{ icon("arrow") }}</button></div></article>
<article id="case-pos" class="project-card client-project" data-category="client"><button class="client-visual pos-visual" data-project="pos" aria-label="{{ t("Ver el proyecto POS en desarrollo", "View the POS project in development") }}"><div class="receipt-scene"><div class="receipt"><div class="receipt-brand">{{ icon("chart") }}{{ t("TU NEGOCIO", "YOUR BUSINESS") }}</div><span class="receipt-subtitle">{{ t("Lo importante, en claro.", "What matters, made clear.") }}</span><div class="receipt-line"><span>{{ t("Ventas", "Sales") }}</span><span>+</span></div><div class="receipt-line"><span>{{ t("Costos fijos", "Fixed costs") }}</span><span>−</span></div><div class="receipt-line"><span>{{ t("Comisiones", "Fees") }}</span><span>−</span></div><div class="receipt-total"><span>{{ t("Ganancia real", "Real profit") }}</span>{{ icon("checkcircle") }}</div><div class="receipt-barcode" aria-hidden="true"></div><span class="receipt-footer">{{ t("DECISIONES CON DATOS", "DATA-INFORMED DECISIONS") }}</span></div><div class="receipt-shadow" aria-hidden="true"></div></div><span class="visual-note">{{ t("Concepto visual · En desarrollo", "Visual concept · In development") }}</span><span class="image-open">{{ icon("arrow") }}</span></button><div class="client-copy"><div class="project-kicker"><span>{{ t("Sistema POS · Cliente privado", "POS system · Private client") }}</span><span class="development-status">{{ t("EN DESARROLLO", "IN DEVELOPMENT") }}</span></div><h3>{{ t("No solo cuánto vendes.<br>Cuánto ganas.", "Not just what you sell.<br>What you earn.") }}</h3><p>{{ t("Inventario automático y rentabilidad real por producto o combo, descontando costos fijos y comisiones.", "Automated inventory and real profitability per product or combo, after fixed costs and fees.") }}</p><button class="text-link" data-project="pos">{{ t("Ver el proyecto", "Explore the project") }}{{ icon("arrow") }}</button></div></article>
</div><div class="work-end reveal"><span>{{ t("El próximo proyecto puede ser el tuyo.", "The next project could be yours.") }}</span><button class="text-link" data-contact>{{ t("Hagámoslo posible", "Let’s make it happen") }}{{ icon("arrow") }}</button></div></div></section>

<section class="section services" id="servicios" aria-labelledby="services-title"><div class="container services-layout"><div class="services-intro reveal"><p class="eyebrow">02 / {{ t("CÓMO PODEMOS AYUDARTE", "HOW WE CAN HELP") }}</p><h2 id="services-title">{{ t("Tu negocio primero.<br>La tecnología después.", "Your business first.<br>Technology second.") }}</h2><p>{{ t("Para cuando una herramienta genérica ya no es suficiente. Construimos lo que tu operación necesita.", "For when an off-the-shelf tool is no longer enough. We build what your operation needs.") }}</p><button class="text-link" data-contact>{{ t("Cuéntanos tu desafío", "Tell us your challenge") }}{{ icon("arrow") }}</button><div class="service-security-hint">{{ icon("shield") }}<span>{{ t("Seguridad desde el diseño.", "Security from the design stage.") }}</span></div></div><div class="services-list">{% for s in services %}<details class="service-card service-detail reveal" name="services" id="service-{{ loop.index }}" style="--delay:{{ loop.index0 * 50 }}ms"><summary><span class="service-number">0{{ loop.index }}</span><span class="service-summary-copy"><span class="service-title">{{ s[1] }}</span><span class="service-description">{{ s[2] }}</span><span class="service-tech">{{ s[3] }}</span></span><span class="service-toggle">{{ icon("plus") }}</span></summary><div class="service-panel"><p class="panel-label">{{ t("QUÉ PODEMOS CONSTRUIR CONTIGO", "WHAT WE CAN BUILD WITH YOU") }}</p><ul>{% for item in service_details[loop.index0]["items"] %}<li>{{ icon("check") }}{{ item }}</li>{% endfor %}</ul><div class="service-related">{% if service_details[loop.index0].case %}<a class="text-link related-project" href="#{{ service_details[loop.index0].case }}">{{ service_details[loop.index0].label }}{{ icon("arrow") }}</a>{% else %}<a class="text-link" href="#enfoque">{{ t("Conoce cómo trabajamos", "See how we work") }}{{ icon("down") }}</a>{% endif %}<button class="text-link service-contact" data-service="{{ s[1] }}">{{ t("Consultar este servicio", "Ask about this service") }}{{ icon("chat") }}</button></div></div></details>{% endfor %}<p class="custom-note">{{ t("Abre un servicio para ver el alcance. También construimos soluciones a pedido.", "Open a service to explore the scope. We also build bespoke solutions.") }}</p></div></div></section>

<section class="stack-strip" aria-labelledby="stack-title"><div class="container stack-inner"><p id="stack-title">{{ t("BUENAS IDEAS.<br>UN GRAN STACK.", "GOOD IDEAS.<br>A GREAT STACK.") }}</p><ul class="stack-logos">{% for tech in stack_logos %}<li><a href="{{ tech.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ tech.name }} — {{ t("documentación oficial, abre otra pestaña", "official documentation, opens a new tab") }}"><img {% if tech.asset.startswith("https:") %}data-stack-asset referrerpolicy="no-referrer"{% endif %} src="{{ tech.asset }}" width="34" height="34" alt="" aria-hidden="true"><span>{{ tech.name }}</span></a></li>{% endfor %}</ul></div></section>

<section class="section process" id="enfoque" aria-labelledby="process-title"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">03 / {{ t("SIN VUELTAS INNECESARIAS", "NO UNNECESSARY COMPLEXITY") }}</p><h2 id="process-title">{{ t("Un proceso claro.<br>De la idea a producción.", "A clear process.<br>From idea to production.") }}</h2></div><p>{{ t("Hablas con quienes construyen.<br>En cada etapa, desde el día uno.", "Talk to the people who build.<br>At every stage, from day one.") }}</p></div><div class="process-grid"><article class="process-step reveal"><span>01</span><h3>{{ t("Entendemos.", "Understand.") }}</h3><p>{{ t("Revisamos tu operación, definimos prioridades y acordamos qué construir.", "We review your operation, define priorities, and agree on what to build.") }}</p><div class="process-deliverable">{{ icon("checkcircle") }}{{ t("Alcance + propuesta", "Scope + proposal") }}</div></article><article class="process-step reveal" style="--delay:70ms"><span>02</span><h3>{{ t("Construimos.", "Build.") }}</h3><p>{{ t("Desarrollamos por etapas y revisamos avances contigo. Puedes ver qué está listo y qué sigue.", "We develop in stages and review progress with you. See what is ready and what comes next.") }}</p><div class="process-deliverable">{{ icon("checkcircle") }}{{ t("Avances revisables", "Reviewable progress") }}</div></article><article class="process-step reveal" style="--delay:140ms"><span>03</span><h3>{{ t("Lo ponemos en marcha.", "Launch.") }}</h3><p>{{ t("Probamos, desplegamos y dejamos acordado el acompañamiento después del lanzamiento.", "We test, deploy, and agree on support after launch.") }}</p><div class="process-deliverable">{{ icon("checkcircle") }}{{ t("Despliegue + continuidad", "Deployment + continuity") }}</div></article></div><div class="security-note reveal"><span class="security-icon">{{ icon("shield") }}</span><p><strong>{{ t("La seguridad no va al final.", "Security isn’t the last step.") }}</strong> {{ t("Es parte de cómo construimos.", "It’s part of how we build.") }}</p><span>SECURITY-FIRST, ALWAYS.</span></div><div class="security-practices reveal" aria-label="{{ t("Aspectos de seguridad a definir por proyecto", "Security considerations to define for each project") }}">
<div>{{ icon("lock") }}<span><strong>{{ t("Accesos con criterio", "Intentional access") }}</strong><small>{{ t("Roles y permisos según tu operación.", "Roles and permissions for your operation.") }}</small></span></div>
<div>{{ icon("shield") }}<span><strong>{{ t("Datos con propósito", "Purposeful data use") }}</strong><small>{{ t("Definir qué se recoge y quién lo necesita.", "Define what is collected and who needs it.") }}</small></span></div>
<div>{{ icon("checkcircle") }}<span><strong>{{ t("Entrega con contexto", "A documented handover") }}</strong><small>{{ t("Acordar documentación y continuidad.", "Agree on documentation and continuity.") }}</small></span></div>
</div><details class="security-reference reveal" id="security-references"><summary><span>{{ icon("building") }}{{ t("Estándares y privacidad: qué referencias considerar", "Standards and privacy: references to consider") }}</span>{{ icon("plus") }}</summary><div class="security-reference-body"><p>{{ t("Los requisitos aplicables y los controles se definen según el alcance del proyecto. Estas referencias no son sellos de certificación ni una garantía de cumplimiento.", "Applicable requirements and controls are defined for each project’s scope. These references are not certification badges or a guarantee of compliance.") }}</p><div class="reference-grid"><div><h3>ISO/IEC 27001:2022</h3><p>{{ t("Requisitos para un sistema de gestión de seguridad de la información. InsideLabs no declara una certificación ISO.", "Requirements for an information security management system. InsideLabs does not claim ISO certification.") }}<a href="https://www.iso.org/standard/27001" target="_blank" rel="noopener noreferrer">{{ t("Fuente oficial: ISO", "Official source: ISO") }} ↗</a></p></div><div><h3>{{ t("Ley 21.719 · Chile", "Law 21.719 · Chile") }}</h3><p>{{ t("Protección y tratamiento de datos personales. Entrada en vigencia: ", "Personal data protection and processing. Effective date: ") }}<strong>01-DIC-2026</strong>.<a href="https://www.bcn.cl/leychile/navegar?idLey=21719" target="_blank" rel="noopener noreferrer">{{ t("Fuente oficial: BCN", "Official source: BCN") }} ↗</a></p></div></div><small>{{ t("La evaluación de cumplimiento requiere revisar el contexto técnico, organizacional y jurídico de cada cliente. No sustituye asesoría legal.", "Compliance evaluation requires reviewing each client’s technical, organizational, and legal context. This is not a substitute for legal advice.") }}</small></div></details></div></section>

<section class="section testimonials" aria-labelledby="testimonials-title"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">{{ t("EL SOFTWARE IMPORTA. LO QUE CAMBIA, MÁS.", "SOFTWARE MATTERS. ITS IMPACT MATTERS MORE.") }}</p><h2 id="testimonials-title">{{ t("Más tiempo para<br>lo que de verdad importa.", "More time for<br>what really matters.") }}</h2></div><p class="testimonial-preview-note">{{ t("Vista previa de testimonios.<br>Textos ilustrativos, no opiniones verificadas.", "Testimonial design preview.<br>Illustrative text, not verified feedback.") }}</p></div><div class="testimonial-grid">{% for q in testimonials %}<article class="testimonial-card reveal" style="--delay:{{ loop.index0 * 60 }}ms"><span class="quote-glyph" aria-hidden="true">“</span><span class="quote-disclaimer">{{ t("EJEMPLO · PENDIENTE DE VALIDACIÓN", "EXAMPLE · AWAITING VALIDATION") }}</span><blockquote>{{ q.text }}</blockquote><div class="quote-context"><span class="quote-context-icon">{{ icon(q.icon) }}</span><div><strong>{{ q.role }}</strong><span>{{ q.context }}</span></div></div></article>{% endfor %}</div><p class="testimonial-footnote">{{ t("Contenido de referencia para esta propuesta. Reemplazar por citas y atribuciones aprobadas antes de publicar.", "Reference content for this proposal. Replace with approved quotes and attribution before publication.") }}</p></div></section>

<section class="section team" id="equipo" aria-labelledby="team-title"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">04 / {{ t("DE ESTE LADO DE LA PANTALLA", "ON THIS SIDE OF THE SCREEN") }}</p><h2 id="team-title">{{ t("Tres socios.<br>Tu equipo de tecnología.", "Three co-founders.<br>Your technology team.") }}</h2></div><p>{{ t("Nacimos en los CTF de HackTheBox y TryHackMe. Hoy convertimos esa curiosidad en software para desafíos reales.", "We started with CTFs on HackTheBox and TryHackMe. Today, we turn that curiosity into software for real challenges.") }}</p></div><div class="team-grid">{% for f in founders %}<article class="team-card reveal" style="--delay:{{ loop.index0 * 70 }}ms"><div class="team-portrait photo-reference"><span class="photo-fallback" aria-hidden="true"><span>{{ f.initials }}</span><small>{{ t("ESPACIO PARA FOTOGRAFÍA", "PHOTOGRAPH PLACEHOLDER") }}</small></span><img data-stock-photo src="{{ portrait_urls[f.github] }}" width="800" height="1000" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="{{ t("Modelo de fotografía de stock para referencia visual. No es una foto del socio.", "Stock photography model for visual reference. Not a photograph of the co-founder.") }}"><span class="portrait-label">{{ t("MODELO DE REFERENCIA · NO ES EL SOCIO", "REFERENCE MODEL · NOT THE CO-FOUNDER") }}</span></div><div class="team-info"><div><h3>{{ f.name }}</h3><p>{{ t("Socio fundador", "Co-founder") }}</p></div><div class="team-socials"><a href="https://www.linkedin.com/in/{{ f.linkedin }}/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn {{ f.name }} — {{ t("otra pestaña", "new tab") }}">{{ icon("linkedin") }}</a><a href="https://github.com/{{ f.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub {{ f.name }} — {{ t("otra pestaña", "new tab") }}">{{ icon("github") }}</a></div></div></article>{% endfor %}</div><p class="placeholder-note">{{ t("Fotografías de stock para visualizar el diseño. No representan a los socios. Se reemplazarán por sus retratos reales.", "Stock photography to preview the design. These models are not the co-founders. Replace with actual team portraits.") }}</p><a class="photo-source-link" href="https://unsplash.com/license" target="_blank" rel="noopener noreferrer">{{ t("Fotografía de referencia: Unsplash ↗", "Reference photography: Unsplash ↗") }}</a></div></section>

<section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div class="faq-intro reveal"><p class="eyebrow">{{ t("ANTES DE DAR EL PASO", "BEFORE THE FIRST STEP") }}</p><h2 id="faq-title">{{ t("Hablemos claro.", "Let’s be clear.") }}</h2><p>{{ t("Buenas preguntas.<br>Respuestas sin letra chica.", "Good questions.<br>No fine print.") }}</p><button class="text-link" data-contact>{{ t("Tengo otra pregunta", "I have another question") }}{{ icon("arrow") }}</button></div><div class="faq-list reveal">{% for faq in faqs %}<details class="faq-item" name="faq"><summary>{{ faq[0] }}{{ icon("plus") }}</summary><p>{{ faq[1] }}</p></details>{% endfor %}</div></div></section>

